<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.example.ui_mobile.ui.AvatarView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:text="Nguyễn Nhật Minh" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nguyễn Nhật Minh" />

            <TextView
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_public"
                android:drawablePadding="4dp"
                android:drawableTint="@color/text_tertiary"
                android:gravity="center_vertical"
                android:text="Công khai" />
        </LinearLayout>
    </LinearLayout>

    <EditText
        android:id="@+id/compose_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_box"
        android:gravity="top|start"
        android:hint="Chia sẻ một khoảnh khắc tĩnh lặng..."
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textCapSentences"
        android:minHeight="120dp"
        android:padding="14dp"
        android:textColor="@color/text_primary"
        android:textSize="16sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/compose_submit"
        style="@style/Widget.Aura.Button.Pill"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:text="Đăng bài" />
</LinearLayout>
