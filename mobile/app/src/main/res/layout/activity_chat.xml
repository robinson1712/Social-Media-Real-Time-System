<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chat_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/chat_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_top_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/chat_back"
            style="@style/IconButton"
            android:contentDescription="Quay lại"
            android:src="@drawable/ic_arrow_back" />

        <com.example.ui_mobile.ui.AvatarView
            android:id="@+id/chat_avatar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            app:avatarOnline="true" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/chat_name"
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/chat_status"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đang hoạt động"
                android:textColor="@color/online" />
        </LinearLayout>

        <ImageView
            android:id="@+id/chat_call"
            style="@style/IconButton"
            android:contentDescription="Gọi thoại"
            android:src="@drawable/ic_phone"
            android:tint="@color/primary" />

        <ImageView
            android:id="@+id/chat_more"
            style="@style/IconButton"
            android:contentDescription="Tùy chọn"
            android:src="@drawable/ic_more_vert"
            android:tint="@color/text_secondary" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chat_messages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/chat_typing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="6dp"
        android:textColor="@color/primary"
        android:textSize="12sp"
        android:textStyle="italic"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/chat_attach"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_circle_lavender"
            android:contentDescription="Đính kèm"
            android:padding="10dp"
            android:src="@drawable/ic_add"
            android:tint="@color/primary" />

        <EditText
            android:id="@+id/chat_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill"
            android:hint="Nhắn một điều dịu dàng..."
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:minHeight="44dp"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/chat_send"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_primary"
            android:contentDescription="Gửi"
            android:paddingStart="13dp"
            android:paddingTop="11dp"
            android:paddingEnd="9dp"
            android:paddingBottom="11dp"
            android:src="@drawable/ic_send"
            android:tint="@color/white" />
    </LinearLayout>
</LinearLayout>
