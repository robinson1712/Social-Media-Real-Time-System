<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/post_pinned"
            style="@style/Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_pin"
            android:drawablePadding="4dp"
            android:drawableTint="@color/primary"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:textColor="@color/primary"
            android:textSize="11sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="6dp"
            android:paddingBottom="10dp">

            <com.example.ui_mobile.ui.AvatarView
                android:id="@+id/post_avatar"
                android:layout_width="44dp"
                android:layout_height="44dp" />

            <LinearLayout
                android:id="@+id/post_author_block"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/post_author"
                        style="@style/Text.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1" />

                    <ImageView
                        android:id="@+id/post_verified"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_verified"
                        android:tint="@color/primary" />

                    <TextView
                        android:id="@+id/post_badge"
                        style="@style/Tag"
                        android:layout_marginStart="6dp"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/post_meta"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:maxLines="1" />
            </LinearLayout>

            <ImageView
                android:id="@+id/post_more"
                style="@style/IconButton"
                android:contentDescription="Tùy chọn"
                android:src="@drawable/ic_more_horiz"
                android:tint="@color/text_secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/post_content"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp" />

        <FrameLayout
            android:id="@+id/post_media"
            android:layout_width="match_parent"
            android:layout_height="260dp">

            <View
                android:id="@+id/post_media_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/post_media_caption"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_gravity="bottom|start"
                android:layout_margin="12dp"
                android:background="@drawable/bg_pill_white"
                android:drawableStart="@drawable/ic_cloud"
                android:drawablePadding="6dp"
                android:drawableTint="@color/text_secondary"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/post_media_counter"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="12dp"
                android:background="@drawable/bg_pill_dark_glass"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp">

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="20dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/bg_badge"
                    android:contentDescription="@null"
                    android:padding="4dp"
                    android:src="@drawable/ic_heart"
                    android:tint="@color/white" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/bg_circle_lavender"
                    android:contentDescription="@null"
                    android:padding="4dp"
                    android:src="@drawable/ic_sparkle"
                    android:tint="@color/primary" />
            </FrameLayout>

            <TextView
                android:id="@+id/post_likes"
                style="@style/Text.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:maxLines="1"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/post_stats_right"
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:background="@color/divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/post_like"
                style="@style/PostAction"
                android:drawableStart="@drawable/ic_heart_outline"
                android:text="Đồng cảm" />

            <TextView
                android:id="@+id/post_comment"
                style="@style/PostAction"
                android:drawableStart="@drawable/ic_comment"
                android:text="Thảo luận" />

            <TextView
                android:id="@+id/post_share"
                style="@style/PostAction"
                android:drawableStart="@drawable/ic_share"
                android:text="Chia sẻ" />

            <ImageView
                android:id="@+id/post_save"
                style="@style/IconButton"
                android:contentDescription="Lưu"
                android:src="@drawable/ic_bookmark_outline"
                android:tint="@color/text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/post_comment_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_box"
            android:orientation="horizontal"
            android:padding="12dp"
            android:visibility="gone">

            <com.example.ui_mobile.ui.AvatarView
                android:id="@+id/post_comment_avatar"
                android:layout_width="30dp"
                android:layout_height="30dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/post_comment_author"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/post_comment_time"
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:id="@+id/post_comment_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:lineSpacingMultiplier="1.2"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
