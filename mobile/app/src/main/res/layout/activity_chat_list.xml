<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chat_list_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="4dp">

        <ImageView
            android:id="@+id/chat_list_back"
            style="@style/IconButton"
            android:contentDescription="Quay lại"
            android:src="@drawable/ic_arrow_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Text.H2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hội thoại tĩnh tại" />

            <TextView
                style="@style/Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Không gian sẻ chia ấm áp và kết nối sâu sắc"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/chat_list_tune"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_alt"
            android:contentDescription="Bộ lọc"
            android:padding="11dp"
            android:src="@drawable/ic_tune"
            android:tint="@color/text_primary" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="96dp">

                <LinearLayout
                    style="@style/InputBox"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_pill">

                    <ImageView
                        style="@style/InputIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_search" />

                    <EditText
                        android:id="@+id/chat_list_search"
                        style="@style/InputField"
                        android:hint="Tìm bạn bè, nhóm trò chuyện..."
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:textSize="15sp" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/chat_list_filters"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Pill"
                            android:text="Tất cả" />

                        <TextView
                            style="@style/Pill"
                            android:text="Chưa đọc  2" />

                        <TextView
                            style="@style/Pill"
                            android:text="Bạn thân" />

                        <TextView
                            style="@style/Pill"
                            android:text="Nhóm dự án" />
                    </LinearLayout>
                </HorizontalScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="9dp"
                        android:layout_height="9dp"
                        android:background="@drawable/bg_dot_online" />

                    <TextView
                        style="@style/Text.Title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="Nhịp sống quanh bạn" />

                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="14 đang online"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/chat_list_online"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.H3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Hội thoại gần đây" />

                    <TextView
                        android:id="@+id/chat_list_mark_read"
                        style="@style/Text.Link"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableEnd="@drawable/ic_done_all"
                        android:drawablePadding="4dp"
                        android:drawableTint="@color/primary"
                        android:gravity="center_vertical"
                        android:text="Đánh dấu đã đọc" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/chat_list_conversations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/chat_list_empty"
                    style="@style/Text.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="Không tìm thấy cuộc trò chuyện phù hợp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/chat_list_suggestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_card_lavender"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_circle_lavender"
                        android:contentDescription="@null"
                        android:padding="9dp"
                        android:src="@drawable/ic_spa"
                        android:tint="@color/primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Gợi ý kết nối" />

                        <TextView
                            style="@style/Text.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Đã lâu bạn chưa trò chuyện với nhóm bạn thời đại học. Gửi một lời chúc ngày mới thanh nhẹ nhé?"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/chat_list_greet"
                                style="@style/Pill.White"
                                android:text="Gửi lời chào 🌿"
                                android:textColor="@color/primary" />

                            <TextView
                                android:id="@+id/chat_list_later"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:padding="8dp"
                                android:text="Để sau"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/chat_list_new"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:contentDescription="Tin nhắn mới"
            android:src="@drawable/ic_edit"
            app:backgroundTint="@color/primary"
            app:shapeAppearanceOverlay="@style/ShapeCircle"
            app:tint="@color/white" />
    </FrameLayout>
</LinearLayout>
