<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_lavender"
                android:contentDescription="@null"
                android:padding="9dp"
                android:src="@drawable/ic_heart_outline"
                android:tint="@color/primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.H2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aura Dating"
                    android:textColor="@color/primary" />

                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kết nối những tâm hồn đồng điệu"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/dating_filter"
                style="@style/Pill"
                android:layout_marginEnd="0dp"
                android:drawableStart="@drawable/ic_tune"
                android:drawableTint="@color/text_primary"
                android:text="Bộ lọc gu" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/dating_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="28dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="340dp">

                    <View
                        android:id="@+id/dating_photo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <com.example.ui_mobile.ui.AvatarView
                        android:id="@+id/dating_avatar"
                        android:layout_width="130dp"
                        android:layout_height="130dp"
                        android:layout_gravity="center"
                        android:layout_marginBottom="30dp"
                        android:alpha="0.9"
                        app:avatarRing="true" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:layout_gravity="bottom"
                        android:background="@drawable/bg_scrim_bottom" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/dating_match"
                            style="@style/Pill.White"
                            android:layout_height="32dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textColor="@color/primary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/dating_song"
                            style="@style/Pill.White"
                            android:layout_height="32dp"
                            android:layout_marginEnd="0dp"
                            android:drawableStart="@drawable/ic_music"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:paddingStart="10dp"
                            android:paddingEnd="12dp"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:gravity="bottom"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/dating_name"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/white"
                                    android:textSize="30sp"
                                    android:textStyle="bold" />

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_marginStart="8dp"
                                    android:background="@drawable/bg_circle_white"
                                    android:contentDescription="Đã xác minh"
                                    android:padding="2dp"
                                    android:src="@drawable/ic_verified"
                                    android:tint="@color/primary" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/dating_job"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:drawableStart="@drawable/ic_leaf"
                                android:drawablePadding="6dp"
                                android:drawableTint="@color/white"
                                android:gravity="center_vertical"
                                android:textColor="@color/white"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/dating_distance"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:background="@drawable/bg_pill_glass"
                            android:gravity="center"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textColor="@color/white"
                            android:textSize="12sp" />
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        style="@style/Text.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Năng lượng &amp; Lối sống"
                        android:textSize="12sp"
                        android:textStyle="normal" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/dating_tags"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:chipSpacingHorizontal="8dp"
                        app:chipSpacingVertical="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_box"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            style="@style/Text.Section"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawableStart="@drawable/ic_sparkle"
                            android:drawablePadding="6dp"
                            android:drawableTint="@color/primary"
                            android:gravity="center_vertical"
                            android:text="Aura Prompt"
                            android:textColor="@color/primary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/dating_prompt"
                            style="@style/Text.H3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingMultiplier="1.2" />

                        <TextView
                            android:id="@+id/dating_answer"
                            style="@style/Text.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/text_secondary"
                            android:textStyle="italic" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_box"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_circle_lavender"
                            android:contentDescription="@null"
                            android:padding="7dp"
                            android:src="@drawable/ic_spa"
                            android:tint="@color/primary" />

                        <TextView
                            android:id="@+id/dating_common"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <TextView
                            style="@style/Text.Link"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tương đồng cao" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/dating_rewind"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_circle_white"
                android:contentDescription="Quay lại"
                android:elevation="3dp"
                android:padding="14dp"
                android:src="@drawable/ic_history"
                android:tint="@color/text_secondary" />

            <ImageView
                android:id="@+id/dating_pass"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_circle_white"
                android:contentDescription="Bỏ qua"
                android:elevation="3dp"
                android:padding="18dp"
                android:src="@drawable/ic_close"
                android:tint="@color/text_primary" />

            <ImageView
                android:id="@+id/dating_super"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_circle_lavender"
                android:contentDescription="Siêu đồng điệu"
                android:elevation="3dp"
                android:padding="15dp"
                android:src="@drawable/ic_sparkle"
                android:tint="@color/primary" />

            <ImageView
                android:id="@+id/dating_like"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_circle_primary"
                android:contentDescription="Thích"
                android:elevation="6dp"
                android:padding="21dp"
                android:src="@drawable/ic_heart"
                android:tint="@color/white" />

            <ImageView
                android:id="@+id/dating_note"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_circle_white"
                android:contentDescription="Gửi lời nhắn"
                android:elevation="3dp"
                android:padding="14dp"
                android:src="@drawable/ic_edit"
                android:tint="@color/primary" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
