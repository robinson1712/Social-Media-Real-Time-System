<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_card_lavender"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <com.example.ui_mobile.ui.AvatarView
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:text="Gốm &amp; Không Gian Tĩnh Tại"
        app:avatarCorner="14dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trang gợi ý cho bạn"
            android:textColor="@color/primary" />

        <TextView
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Gốm &amp; Không Gian Tĩnh Tại" />

        <TextView
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Nghệ thuật &amp; Đời sống • 42.5K người theo dõi" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/suggestion_open"
        style="@style/Widget.Aura.Button.Pill"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="Xem trang"
        android:textSize="13sp" />
</LinearLayout>
