<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <!-- Top app bar -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_square_lavender"
            android:contentDescription="Aura"
            android:padding="6dp"
            android:src="@drawable/ic_logo" />

        <TextView
            android:id="@+id/top_search"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="8dp"
            android:drawableTint="@color/text_secondary"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Tìm kiếm trong salon..."
            android:textColor="@color/text_tertiary"
            android:textSize="14sp" />

        <FrameLayout
            android:id="@+id/top_chat"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="Trò chuyện"
                android:src="@drawable/ic_comment"
                android:tint="@color/text_primary" />

            <TextView
                android:id="@+id/top_chat_badge"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_badge"
                android:gravity="center"
                android:text="3"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold" />
        </FrameLayout>

        <com.example.ui_mobile.ui.AvatarView
            android:id="@+id/top_avatar"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:text="Nguyễn Nhật Minh" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bottom navigation (6 tabs, so not a BottomNavigationView which caps at 5) -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_bar"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/nav_feed"
                style="@style/NavItem">

                <ImageView
                    style="@style/NavIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_spa" />

                <TextView
                    style="@style/NavLabel"
                    android:text="Bảng tin" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_reels"
                style="@style/NavItem">

                <ImageView
                    style="@style/NavIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_reels" />

                <TextView
                    style="@style/NavLabel"
                    android:text="Reels" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_groups"
                style="@style/NavItem">

                <ImageView
                    style="@style/NavIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_group" />

                <TextView
                    style="@style/NavLabel"
                    android:text="Nhóm" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_dating"
                style="@style/NavItem">

                <ImageView
                    style="@style/NavIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_heart_outline" />

                <TextView
                    style="@style/NavLabel"
                    android:text="Hẹn hò" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_alerts"
                style="@style/NavItem">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        style="@style/NavIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_bell" />

                    <View
                        android:id="@+id/nav_alerts_dot"
                        android:layout_width="9dp"
                        android:layout_height="9dp"
                        android:layout_gravity="top|end"
                        android:background="@drawable/bg_badge" />
                </FrameLayout>

                <TextView
                    style="@style/NavLabel"
                    android:text="Thông báo" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_profile"
                style="@style/NavItem">

                <ImageView
                    style="@style/NavIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_person" />

                <TextView
                    style="@style/NavLabel"
                    android:text="Cá nhân" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
