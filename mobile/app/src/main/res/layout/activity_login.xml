<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/login_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_auth"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="24dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <include layout="@layout/layout_auth_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_pill_lavender"
            android:drawableStart="@drawable/ic_spa"
            android:drawablePadding="8dp"
            android:drawableTint="@color/primary"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="16dp"
            android:text="Không gian kết nối tĩnh tại"
            android:textColor="@color/primary"
            android:textSize="13sp" />

        <TextView
            style="@style/Text.H1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Chào mừng bạn trở lại" />

        <TextView
            style="@style/Text.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Nơi kết nối những tâm hồn đồng điệu và sẻ chia những chiêm nghiệm cuộc sống"
            android:textSize="15sp" />

        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Email hoặc Số điện thoại"
                    android:textSize="14sp" />

                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bắt buộc" />
            </LinearLayout>

            <LinearLayout
                style="@style/InputBox"
                android:layout_marginTop="8dp">

                <ImageView
                    style="@style/InputIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_mail" />

                <EditText
                    android:id="@+id/login_email"
                    style="@style/InputField"
                    android:autofillHints="emailAddress"
                    android:hint="nhap.email@aura.vn"
                    android:inputType="textEmailAddress" />
            </LinearLayout>

            <TextView
                style="@style/Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Mật khẩu"
                android:textSize="14sp" />

            <LinearLayout
                style="@style/InputBox"
                android:layout_marginTop="8dp">

                <ImageView
                    style="@style/InputIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_lock" />

                <EditText
                    android:id="@+id/login_password"
                    style="@style/InputField"
                    android:autofillHints="password"
                    android:hint="••••••••••••"
                    android:inputType="textPassword" />

                <ImageView
                    android:id="@+id/login_toggle_password"
                    style="@style/IconButton"
                    android:contentDescription="Hiện mật khẩu"
                    android:src="@drawable/ic_visibility_off"
                    android:tint="@color/text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/login_remember"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="@color/primary"
                    android:checked="true"
                    android:text="Ghi nhớ đăng nhập"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/login_forgot"
                    style="@style/Text.Link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="6dp"
                    android:text="Quên mật khẩu?"
                    android:textSize="14sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/login_submit"
                style="@style/Widget.Aura.Button.Pill"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:text="Đăng nhập"
                android:textSize="16sp"
                app:icon="@drawable/ic_arrow_forward"
                app:iconGravity="textEnd" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/divider" />

            <TextView
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Hoặc tiếp tục với"
                android:textSize="13sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/divider" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/login_google"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_social"
                android:gravity="center"
                android:text="G"
                android:textColor="#4285F4"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/login_apple"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:background="@drawable/bg_social"
                android:gravity="center"
                android:text="Apple"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/login_facebook"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_social"
                android:gravity="center"
                android:text="f"
                android:textColor="#1877F2"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chưa có tài khoản?  "
                android:textSize="15sp" />

            <TextView
                android:id="@+id/login_go_register"
                style="@style/Text.Link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đăng ký ngay"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:drawableStart="@drawable/ic_shield"
            android:drawablePadding="10dp"
            android:drawableTint="@color/primary"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Aura cam kết bảo vệ dữ liệu cá nhân &amp; thông tin trao đổi riêng tư của bạn." />
    </LinearLayout>
</ScrollView>
