<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/register_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="20dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <include layout="@layout/layout_auth_logo" />

        <TextView
            style="@style/Text.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Không gian kết nối điềm tĩnh"
            android:textColor="@color/primary"
            android:textStyle="normal" />

        <TextView
            style="@style/Text.H1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Tạo tài khoản mới" />

        <TextView
            style="@style/Text.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Bắt đầu hành trình kết nối tĩnh tại và sâu sắc cùng Aura"
            android:textSize="15sp" />

        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Họ và tên" />

            <LinearLayout
                style="@style/InputBox"
                android:layout_height="52dp"
                android:layout_marginTop="6dp">

                <ImageView
                    style="@style/InputIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_person" />

                <EditText
                    android:id="@+id/register_name"
                    style="@style/InputField"
                    android:autofillHints="name"
                    android:hint="Nguyễn An Nhiên"
                    android:inputType="textPersonName|textCapWords" />
            </LinearLayout>

            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Email hoặc Số điện thoại" />

            <LinearLayout
                style="@style/InputBox"
                android:layout_height="52dp"
                android:layout_marginTop="6dp">

                <ImageView
                    style="@style/InputIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_mail" />

                <EditText
                    android:id="@+id/register_email"
                    style="@style/InputField"
                    android:autofillHints="emailAddress"
                    android:hint="aura.friend@domain.vn"
                    android:inputType="textEmailAddress" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Mật khẩu" />

                <TextView
                    android:id="@+id/register_strength_label"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Độ mạnh: Chưa nhập" />
            </LinearLayout>

            <LinearLayout
                style="@style/InputBox"
                android:layout_height="52dp"
                android:layout_marginTop="6dp">

                <ImageView
                    style="@style/InputIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_lock" />

                <EditText
                    android:id="@+id/register_password"
                    style="@style/InputField"
                    android:autofillHints="newPassword"
                    android:hint="Tối thiểu 8 ký tự"
                    android:inputType="textPassword" />

                <ImageView
                    android:id="@+id/register_toggle_password"
                    style="@style/IconButton"
                    android:contentDescription="Hiện mật khẩu"
                    android:src="@drawable/ic_visibility"
                    android:tint="@color/text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/register_strength_bars"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_bar" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_bar" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_bar" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_bar" />
            </LinearLayout>

            <TextView
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Xác nhận mật khẩu" />

            <LinearLayout
                style="@style/InputBox"
                android:layout_height="52dp"
                android:layout_marginTop="6dp">

                <ImageView
                    style="@style/InputIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_shield" />

                <EditText
                    android:id="@+id/register_confirm"
                    style="@style/InputField"
                    android:autofillHints="newPassword"
                    android:hint="Nhập lại mật khẩu"
                    android:inputType="textPassword" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/register_terms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:buttonTint="@color/primary"
                android:lineSpacingMultiplier="1.2"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/register_submit"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="Tạo tài khoản"
                android:textSize="16sp"
                app:icon="@drawable/ic_arrow_forward"
                app:iconGravity="textEnd" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/divider" />

                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="hoặc tiếp tục với" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/divider" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/register_google"
                    style="@style/Widget.Aura.Button.Soft"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Google" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/register_apple"
                    style="@style/Widget.Aura.Button.Soft"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="Apple" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_spa"
                android:drawablePadding="6dp"
                android:drawableTint="@color/primary"
                android:gravity="center_vertical"
                android:text="Bảo mật tĩnh tại"
                android:textSize="13sp" />

            <TextView
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="•" />

            <TextView
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_sparkle"
                android:drawablePadding="6dp"
                android:drawableTint="@color/primary"
                android:gravity="center_vertical"
                android:text="Không thuật toán ồn ã"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đã có tài khoản?  "
                android:textSize="15sp" />

            <TextView
                android:id="@+id/register_go_login"
                style="@style/Text.Link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đăng nhập"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
