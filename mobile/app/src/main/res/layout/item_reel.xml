<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/reel_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/reel_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="340dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_scrim_bottom" />

    <ImageView
        android:id="@+id/reel_big_heart"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_gravity="center"
        android:alpha="0"
        android:contentDescription="@null"
        android:src="@drawable/ic_heart"
        android:tint="@color/white" />

    <!-- Right action column -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="28dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/reel_like"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_circle_glass"
            android:contentDescription="Thích"
            android:padding="13dp"
            android:src="@drawable/ic_heart_outline"
            android:tint="@color/white" />

        <TextView
            android:id="@+id/reel_like_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/reel_comment"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_circle_glass"
            android:contentDescription="Bình luận"
            android:padding="14dp"
            android:src="@drawable/ic_comment"
            android:tint="@color/white" />

        <TextView
            android:id="@+id/reel_comment_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/reel_save"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_circle_glass"
            android:contentDescription="Lưu"
            android:padding="14dp"
            android:src="@drawable/ic_bookmark_outline"
            android:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Lưu"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/reel_share"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_circle_glass"
            android:contentDescription="Chia sẻ"
            android:padding="15dp"
            android:src="@drawable/ic_send"
            android:tint="@color/white" />

        <TextView
            android:id="@+id/reel_share_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/reel_disc"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_circle_dark_glass"
            android:padding="10dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_circle_lavender" />

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_dot_primary" />
        </FrameLayout>
    </LinearLayout>

    <!-- Author, caption, audio -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="80dp"
        android:layout_marginBottom="24dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.example.ui_mobile.ui.AvatarView
                android:id="@+id/reel_avatar"
                android:layout_width="50dp"
                android:layout_height="50dp"
                app:avatarRing="true" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/reel_handle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/white"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/reel_follow"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_pill_primary"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:textColor="@color/white"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/reel_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#E6FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/reel_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.2"
            android:maxLines="3"
            android:textColor="@color/white"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/reel_music"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_pill_glass"
            android:drawableStart="@drawable/ic_music"
            android:drawablePadding="6dp"
            android:drawableTint="@color/white"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingEnd="14dp"
            android:textColor="@color/white"
            android:textSize="12sp" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/reel_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:max="1000"
        app:indicatorColor="@color/primary_bright"
        app:trackColor="#33FFFFFF"
        app:trackCornerRadius="2dp"
        app:trackThickness="3dp" />
</FrameLayout>
