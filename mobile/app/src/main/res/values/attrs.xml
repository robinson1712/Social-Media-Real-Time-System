<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="AvatarView">
        <!-- Draws a green presence dot at the bottom-right corner. -->
        <attr name="avatarOnline" format="boolean" />
        <!-- Draws a white ring around the avatar (for avatars overlapping a cover image). -->
        <attr name="avatarRing" format="boolean" />
        <!-- Corner radius; 0 (default) draws a circle. -->
        <attr name="avatarCorner" format="dimension" />
    </declare-styleable>
</resources>
