# Copy this file to .env (same folder as docker-compose.yml) and fill in the values.
# .env is git-ignored - never commit real passwords.

# ---------------------------------------------------------------------------
# Database mode
#   (empty)  -> local postgres container (default, nothing else needed)
#   supabase -> Supabase cloud Postgres, configured below
# ---------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=supabase

# ---------------------------------------------------------------------------
# Supabase: Project Settings -> Database -> Connection string
#   -> choose "Transaction pooler" (port 6543), NOT "Direct connection"
#      (direct is IPv6-only and fails on most home/dorm networks).
#
# Example pooler string:
#   postgresql://postgres.abcdefghijklmnop:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
#                ^^^^^^^^^^^^^^^^^^^^^^^^^                    ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
#                SUPABASE_DB_USER                             SUPABASE_DB_HOST
# ---------------------------------------------------------------------------
SUPABASE_DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_USER=postgres.your-project-ref
SUPABASE_DB_PASSWORD=your-database-password

# MongoDB Atlas cho chat/notification/story/reels. Thêm "atlas" vào SPRING_PROFILES_ACTIVE
# (ví dụ supabase,atlas). Chuỗi không kèm tên database; service tự gắn /<tên_db>.
# Atlas: Network Access phải cho phép IP máy chạy docker.
MONGO_ATLAS_BASE_URI=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net

# Connections per service (10 services share the free-tier limit).
SUPABASE_DB_POOL_SIZE=3
